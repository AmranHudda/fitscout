# Required
OPENAI_API_KEY=
FITSCOUT_TOKEN=            # long random string; Muse connector key, cron auth, push-button signing
CRON_SECRET=               # Vercel sends this to the daily cron
NTFY_TOPIC=                # long random topic name; subscribe to it in the ntfy phone app

# Storage: Upstash Redis from the Vercel Marketplace sets these automatically
KV_REST_API_URL=
KV_REST_API_TOKEN=

# eBay Browse API (free developer app at developer.ebay.com) — enables the daily eBay sweep
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional
# FITSCOUT_DAILY_BUDGET_USD=2
# FITSCOUT_MAX_JUDGES_PER_DAY=400
# FITSCOUT_SCOUT_QUERIES_PER_RUN=12   # scout searches per daily sweep (rotates through all of them)
# FITSCOUT_MAX_PUSHES_PER_RUN=6
# FITSCOUT_HUNT_MIN_MATCH=8
# OPENAI_VISION_MODEL=gpt-5.4-mini
# OPENAI_JUDGE_MODEL=gpt-5.4-mini
# OPENAI_SYNTH_MODEL=gpt-5.6-sol
# OPENAI_PRICE_GPT_5_4_MINI=1,6   # USD per 1M tokens in,out — set real prices for accurate caps
